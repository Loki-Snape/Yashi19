@{
    ViewData["Title"] = "Contact Support";
}

<div class="premium-card" style="max-width: 600px; margin: 0 auto;">
    <h3 class="mb-4" style="font-family:var(--font-outfit); font-weight:700;">Get in Touch</h3>
    <p class="text-muted mb-4">Have questions about subscription status, catalog details, or feature requests? Contact our administrative team below.</p>

    <form onsubmit="event.preventDefault(); alert('Message sent successfully! (Mock Action)');">
        <div class="mb-3">
            <label class="form-label fw-semibold">Your Name</label>
            <input type="text" class="form-control" placeholder="Enter your name" required style="border-radius:8px;" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Email Address</label>
            <input type="email" class="form-control" placeholder="name@example.com" required style="border-radius:8px;" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Subject</label>
            <input type="text" class="form-control" placeholder="Topic of discussion" required style="border-radius:8px;" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Message Body</label>
            <textarea class="form-control" rows="4" placeholder="Detail your inquiry..." required style="border-radius:8px;"></textarea>
        </div>

        <button type="submit" class="btn-premium w-100 justify-content-center">Send Inquiry</button>
    </form>
</div>
