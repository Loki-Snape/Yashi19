@{
    ViewData["Title"] = "About Athena";
}

<div class="premium-card" style="max-width: 800px; margin: 0 auto; line-height: 1.8;">
    <h3 class="mb-4" style="font-family:var(--font-outfit); font-weight:700;">About Athena Enterprise Library</h3>
    
    <p class="lead text-muted mb-4">
        Athena is a cutting-edge, enterprise-grade Library Management System designed to optimize resource indexing, staff delegation, and member-based transactions.
    </p>

    <h5 class="fw-bold mt-4 mb-2">Our Mission</h5>
    <p class="text-secondary mb-4">
        We empower institutions to manage books, newspapers, academic journals, and digital media seamlessly. By integrating advanced tracking algorithms, real-time availability calculations, and secure role-based access control (RBAC), we ensure that knowledge is always accessible and organized.
    </p>

    <h5 class="fw-bold mt-4 mb-2">Key Features</h5>
    <div class="row g-3 text-secondary mb-4">
        <div class="col-md-6">
            <div class="p-3 border rounded bg-light">
                <i class="fa-solid fa-shield-halved text-primary me-2"></i> <strong>Role-Based Access</strong>
                <p class="small text-muted mb-0 mt-1">Pre-configured workflows for Admin, Librarian, and Member tiers.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded bg-light">
                <i class="fa-solid fa-magnifying-glass text-primary me-2"></i> <strong>Optimized Searching</strong>
                <p class="small text-muted mb-0 mt-1">Instant server-side lookups for Title, Author, or ISBN.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded bg-light">
                <i class="fa-solid fa-arrows-spin text-primary me-2"></i> <strong>Transaction Workflows</strong>
                <p class="small text-muted mb-0 mt-1">Frictionless check-out, automated due-date calculations, and quick return actions.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded bg-light">
                <i class="fa-solid fa-chart-line text-primary me-2"></i> <strong>Interactive Reporting</strong>
                <p class="small text-muted mb-0 mt-1">Real-time statistics dashboard with active borrowing metrics.</p>
            </div>
        </div>
    </div>
</div>
