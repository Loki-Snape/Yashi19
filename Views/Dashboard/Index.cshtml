@model LibraryManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "System Control Dashboard";
}

<!-- Bootstrap Icons CDN for metric icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-4 px-4">
    <!-- Header & Quick Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h2 class="fw-bold text-cyan mb-1">
                <i class="bi bi-speedometer2 me-2"></i>ARCHIVAL SYSTEM DASHBOARD
            </h2>
            <p class="text-muted small mb-0">Real-time sector index telemetry and asset tracking</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Books" asp-action="Index" class="btn btn-outline-info btn-sm">
                <i class="bi bi-book me-1"></i> Books Catalog
            </a>
            <a asp-controller="Publications" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-newspaper me-1"></i> Publications
            </a>
            <a asp-controller="Students" asp-action="Index" class="btn btn-outline-light btn-sm">
                <i class="bi bi-people me-1"></i> Agents Directory
            </a>
        </div>
    </div>

    <!-- Top Metrics Grid (4 Cards Row 1) -->
    <div class="row g-3 mb-4">
        <!-- Book Collection -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-dark text-light border-secondary h-100 shadow-sm position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold fs-7 d-block mb-1">Book Collection</span>
                        <h2 class="display-6 fw-bold mb-0 text-cyan">@Model.TotalBooks</h2>
                        <small class="text-muted">Total physical copies registered</small>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                        <i class="bi bi-journals fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Publications -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-dark text-light border-secondary h-100 shadow-sm position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold fs-7 d-block mb-1">Publications</span>
                        <h2 class="display-6 fw-bold mb-0 text-primary">@Model.TotalPublications</h2>
                        <small class="text-muted">Newspapers & Magazines</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-newspaper fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Active Members -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-dark text-light border-secondary h-100 shadow-sm position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold fs-7 d-block mb-1">Active Agents</span>
                        <h2 class="display-6 fw-bold mb-0 text-success">@Model.TotalStudents</h2>
                        <small class="text-muted">Enrolled agent profiles</small>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Staff Count -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-dark text-light border-secondary h-100 shadow-sm position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold fs-7 d-block mb-1">Staff Count</span>
                        <h2 class="display-6 fw-bold mb-0 text-warning">@Model.TotalLibrarians</h2>
                        <small class="text-muted">Management Librarians</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-shield-lock fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Borrowing Telemetry Grid (3 Cards Row 2) -->
    <div class="row g-3 mb-4">
        <!-- Active Borrowings -->
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-cyan bg-opacity-10 p-2 rounded text-cyan">
                            <i class="bi bi-box-arrow-up-right fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase d-block">Active Borrowings</span>
                            <h3 class="fw-bold mb-0">@Model.ActiveBorrowings</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Overdue Borrowings -->
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-danger bg-opacity-10 p-2 rounded text-danger">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase d-block">Overdue Borrowings</span>
                            <h3 class="fw-bold mb-0 text-danger">@Model.OverdueBorrowings</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Total Transactions -->
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-secondary bg-opacity-20 p-2 rounded text-light">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase d-block">Total Transactions</span>
                            <h3 class="fw-bold mb-0">@Model.TotalTransactions</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Transactions Table Card -->
    <div class="card bg-dark text-light border-secondary shadow-sm">
        <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold text-cyan">
                <i class="bi bi-clock-history me-2"></i>Recent Borrow Transactions
            </h5>
            <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-info">
                View Books Collection
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-black border-bottom border-secondary text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">Book Title</th>
                            <th>Student Card ID</th>
                            <th>Borrow Date</th>
                            <th>Due Date</th>
                            <th class="pe-4 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                        {
                            foreach (var item in Model.RecentTransactions)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium">@item.BookTitle</td>
                                    <td><span class="badge bg-secondary">@item.StudentCardId</span></td>
                                    <td>@item.BorrowDate.ToShortDateString()</td>
                                    <td>@item.DueDate.ToShortDateString()</td>
                                    <td class="pe-4 text-end">
                                        <span class="badge @(item.IsReturned ? "bg-success" : (item.DueDate < DateTime.Now ? "bg-danger" : "bg-warning text-dark"))">
                                            @(item.IsReturned ? "Returned" : (item.DueDate < DateTime.Now ? "Overdue" : "Active"))
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No recent borrow records found in current sector logs.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Executive Dashboard";
}

<!-- Statistics Grid -->
<div class="row g-4">
    <!-- Books Card -->
    <div class="col-md-3">
        <div class="premium-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted font-monospace text-uppercase" style="font-size:0.75rem; letter-spacing:0.5px;">Book Collection</span>
                <span class="badge badge-premium badge-primary"><i class="fa-solid fa-book"></i></span>
            </div>
            <h3 class="mb-1" style="font-family:var(--font-outfit); font-weight:800; font-size:2.2rem;">@Model.TotalBooks</h3>
            <span class="text-muted style-subtext" style="font-size:0.85rem;">Total physical copies owned</span>
        </div>
    </div>

    <!-- Publications Card -->
    <div class="col-md-3">
        <div class="premium-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted font-monospace text-uppercase" style="font-size:0.75rem; letter-spacing:0.5px;">Publications</span>
                <span class="badge badge-premium badge-success"><i class="fa-solid fa-newspaper"></i></span>
            </div>
            <h3 class="mb-1" style="font-family:var(--font-outfit); font-weight:800; font-size:2.2rem;">@Model.TotalPublications</h3>
            <span class="text-muted style-subtext" style="font-size:0.85rem;">Newspapers & Magazines</span>
        </div>
    </div>

    <!-- Students Card -->
    <div class="col-md-3">
        <div class="premium-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted font-monospace text-uppercase" style="font-size:0.75rem; letter-spacing:0.5px;">Active Members</span>
                <span class="badge badge-premium badge-warning"><i class="fa-solid fa-user-graduate"></i></span>
            </div>
            <h3 class="mb-1" style="font-family:var(--font-outfit); font-weight:800; font-size:2.2rem;">@Model.TotalStudents</h3>
            <span class="text-muted style-subtext" style="font-size:0.85rem;">Enrolled students profile</span>
        </div>
    </div>

    <!-- Librarians Card -->
    <div class="col-md-3">
        <div class="premium-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted font-monospace text-uppercase" style="font-size:0.75rem; letter-spacing:0.5px;">Staff Count</span>
                <span class="badge badge-premium badge-danger"><i class="fa-solid fa-user-tie"></i></span>
            </div>
            <h3 class="mb-1" style="font-family:var(--font-outfit); font-weight:800; font-size:2.2rem;">@Model.TotalLibrarians</h3>
            <span class="text-muted style-subtext" style="font-size:0.85rem;">Management librarians</span>
        </div>
    </div>
</div>

<!-- Extra Borrowing Analytics Row -->
<div class="row g-4 mt-2">
    <!-- Active Borrowings -->
    <div class="col-md-4">
        <div class="premium-card" style="border-left: 4px solid var(--primary);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="text-muted mb-1" style="font-size: 0.85rem; font-weight:600;">ACTIVE BORROWINGS</h5>
                    <h2 class="mb-0" style="font-family:var(--font-outfit); font-weight:800;">@Model.ActiveBorrowings</h2>
                </div>
                <div class="text-primary"><i class="fa-solid fa-clock-rotate-left fa-2x"></i></div>
            </div>
        </div>
    </div>

    <!-- Overdue Borrowings -->
    <div class="col-md-4">
        <div class="premium-card" style="border-left: 4px solid var(--danger);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="text-muted mb-1" style="font-size: 0.85rem; font-weight:600;">OVERDUE BORROWINGS</h5>
                    <h2 class="mb-0 text-danger" style="font-family:var(--font-outfit); font-weight:800;">@Model.OverdueBorrowings</h2>
                </div>
                <div class="text-danger"><i class="fa-solid fa-circle-exclamation fa-2x"></i></div>
            </div>
        </div>
    </div>

    <!-- Total Transactions -->
    <div class="col-md-4">
        <div class="premium-card" style="border-left: 4px solid var(--success);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="text-muted mb-1" style="font-size: 0.85rem; font-weight:600;">TOTAL TRANSACTIONS</h5>
                    <h2 class="mb-0" style="font-family:var(--font-outfit); font-weight:800;">@Model.TotalBorrowings</h2>
                </div>
                <div class="text-success"><i class="fa-solid fa-arrow-right-arrow-left fa-2x"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Borrowings Section -->
<div class="table-container mt-4">
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-light">
        <h5 class="mb-0" style="font-family:var(--font-outfit); font-weight:700;">Recent Borrow Transactions</h5>
        <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-secondary">View Books Collection</a>
    </div>
    
    <table class="custom-table">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Student</th>
                <th>Card ID</th>
                <th>Borrow Date</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentBorrowings.Any())
            {
                foreach (var record in Model.RecentBorrowings)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@(record.BookTitle)</td>
                        <td>@(record.StudentName ?? "Unknown Student")</td>
                        <td><code class="px-2 py-1 bg-light rounded text-dark">@(record.StudentCardId ?? "N/A")</code></td>
                        <td>@record.BorrowDate.ToString("MMM dd, yyyy")</td>
                        <td>@record.DueDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (record.IsReturned)
                            {
                                <span class="badge badge-premium badge-success"><i class="fa-solid fa-circle-check"></i> Returned</span>
                            }
                            else if (record.DueDate < DateTime.Today)
                            {
                                <span class="badge badge-premium badge-danger"><i class="fa-solid fa-triangle-exclamation"></i> Overdue</span>
                            }
                            else
                            {
                                <span class="badge badge-premium badge-warning"><i class="fa-solid fa-hourglass-half"></i> Borrowed</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">No recent borrow records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
