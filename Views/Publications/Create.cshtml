@model Publication
@{
    ViewData["Title"] = "Register Publication Asset";
}

<div class="mib-card" style="max-width: 600px; margin: 0 auto;">
    <h3 class="tech-header text-white mb-4">REGISTER NEW PUBLICATION</h3>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold text-white"></label>
            <input asp-for="Title" class="form-control" placeholder="Enter title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label fw-bold text-white">Publication Type</label>
            <select asp-for="Type" class="form-select">
                <option value="Newspaper">Newspaper</option>
                <option value="Magazine">Magazine</option>
            </select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Publisher" class="form-label fw-bold text-white"></label>
            <input asp-for="Publisher" class="form-control" placeholder="Enter publisher name" />
            <span asp-validation-for="Publisher" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IssueNumber" class="form-label fw-bold text-white"></label>
            <input asp-for="IssueNumber" class="form-control" placeholder="e.g. Vol. 9 No. 1" />
            <span asp-validation-for="IssueNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ReleaseDate" class="form-label fw-bold text-white"></label>
            <input asp-for="ReleaseDate" type="date" class="form-control" />
            <span asp-validation-for="ReleaseDate" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Frequency" class="form-label fw-bold text-white"></label>
            <input asp-for="Frequency" class="form-control" placeholder="e.g. Daily, Weekly, Monthly" />
            <span asp-validation-for="Frequency" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center border-top border-secondary pt-3">
            <a asp-action="Index" class="btn-outline-mib">Cancel</a>
            <button type="submit" class="btn-cyan">Register Asset</button>
        </div>
    </form>
</div>
