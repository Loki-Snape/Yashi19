@model Publication
@{
    ViewData["Title"] = "Destroy Publication Asset";
}

<div class="mib-card text-center" style="max-width: 500px; margin: 50px auto; border-color: var(--mib-crimson);">
    <div class="text-danger mb-3"><i class="fa-solid fa-triangle-exclamation fa-4x text-danger"></i></div>
    <h3 class="tech-header text-danger mb-2">DESTROY DATA RECORD</h3>
    <p class="text-muted mb-4">Are you certain you want to purge <strong>@Model.Title</strong> from active registry?</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" class="btn-outline-mib">Cancel</a>
            <button type="submit" class="btn-crimson">Confirm Purge</button>
        </div>
    </form>
</div>
