@model LibraryManagementSystem.ViewModels.LibrarianIndexViewModel
@{
    ViewData["Title"] = "Librarians Directory";
}
<div class="card card-stat mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Search librarians by name, employee ID, or email..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold bg-dark-purple border-0">Search</button>
            </div>
        </form>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle shadow-sm">
        <thead>
            <tr>
                <th>Employee ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Hire Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Librarians != null && Model.Librarians.Any())
            {
                @foreach (var librarian in Model.Librarians)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark fw-bold border">@librarian.EmployeeId</span></td>
                        <td class="fw-semibold">@librarian.FirstName</td>
                        <td class="fw-semibold">@librarian.LastName</td>
                        <td><a href="mailto:@librarian.Email" class="text-decoration-none text-purple-dark">@librarian.Email</a></td>
                        <td>@librarian.HireDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                        <i class="fas fa-user-slash fa-2x mb-2 d-block"></i>
                        No librarian records found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
        <nav aria-label="Librarian pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchQuery="@Model.SearchQuery">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchQuery="@Model.SearchQuery">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchQuery="@Model.SearchQuery">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
