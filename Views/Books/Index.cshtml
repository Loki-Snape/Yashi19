@model BookListViewModel
@{
    ViewData["Title"] = "Archived Books Catalog";
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h2 class="tech-header mb-0">ARCHIVED BOOKS CATALOG</h2>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn-cyan">
            <i class="fa-solid fa-plus me-1"></i> Register New Book Asset
        </a>
    </div>
</div>

<div class="mib-card mb-4">
    <!-- Search & Filter Form -->
    <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-black text-cyan border-secondary" style="font-family:var(--font-mono);"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by Title, Author, ISBN..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn-cyan w-100">Filter Matrix</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Index" class="btn-outline-mib d-flex align-items-center justify-content-center" style="padding: 10px 16px;"><i class="fa-solid fa-rotate-left"></i></a>
            }
        </div>
    </form>
</div>

<!-- Books Matrix -->
<div class="mib-table-container">
    <table class="mib-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>ISBN Code</th>
                <th>Publisher</th>
                <th>Publish Date</th>
                <th>Availability</th>
                <th class="text-end">Confidential Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Books.Any())
            {
                foreach (var item in Model.Books)
                {
                    <tr>
                        <td class="fw-bold text-white">@item.Title</td>
                        <td>@item.Author</td>
                        <td><code class="text-cyan px-2 py-1 bg-black rounded" style="border: 1px solid var(--mib-border);">@item.ISBN</code></td>
                        <td>@item.Publisher</td>
                        <td style="font-family:var(--font-mono);">@item.PublishDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.AvailableCopies == 0)
                            {
                                <span class="mib-badge mib-badge-crimson"><i class="fa-solid fa-lock"></i> All Borrowed</span>
                            }
                            else
                            {
                                <span class="mib-badge mib-badge-cyan"><i class="fa-solid fa-lock-open"></i> @item.AvailableCopies / @item.TotalCopies Copies</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group gap-1">
                                @if (item.AvailableCopies > 0)
                                {
                                    <a asp-action="Borrow" asp-route-id="@item.Id" class="btn btn-sm btn-cyan py-1 px-3" style="font-size: 0.8rem;">Borrow</a>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-mib py-1 px-2" style="font-size: 0.8rem;"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-gold py-1 px-2" style="font-size: 0.8rem;"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-crimson py-1 px-2" style="font-size: 0.8rem;"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted" style="font-family:var(--font-mono);">NO RECORDS FOUND WITHIN SECTOR INDEX.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination Controls -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4" style="font-family:var(--font-mono);">
        <span class="text-muted">
            INDEX SECTOR PAGE <strong>@Model.PageNumber</strong> OF <strong>@Model.TotalPages</strong>
        </span>
        <ul class="pagination mb-0 gap-1">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link bg-dark text-cyan border-secondary" asp-action="Index" asp-route-searchQuery="@Model.SearchQuery" asp-route-pageNumber="@(Model.PageNumber - 1)">PREV</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link @(i == Model.PageNumber ? "bg-cyan text-black border-cyan fw-bold" : "bg-dark text-white border-secondary")" asp-action="Index" asp-route-searchQuery="@Model.SearchQuery" asp-route-pageNumber="@i">@i</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link bg-dark text-cyan border-secondary" asp-action="Index" asp-route-searchQuery="@Model.SearchQuery" asp-route-pageNumber="@(Model.PageNumber + 1)">NEXT</a>
            </li>
        </ul>
    </div>
}
