@model Book
@{
    ViewData["Title"] = "Delete Book";
}

<div class="premium-card text-center" style="max-width: 500px; margin: 50px auto;">
    <div class="text-danger mb-3"><i class="fa-solid fa-triangle-exclamation fa-4x"></i></div>
    <h3 class="mb-2" style="font-family:var(--font-outfit); font-weight:700;">Are you sure?</h3>
    <p class="text-muted mb-4">You are about to delete <strong>@Model.Title</strong>. This action cannot be undone.</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" class="btn btn-light" style="border-radius:8px; padding: 10px 24px;">Cancel</a>
            <button type="submit" class="btn btn-danger" style="border-radius:8px; padding: 10px 24px;">Delete Permanently</button>
        </div>
    </form>
</div>
