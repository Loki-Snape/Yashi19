@model Book
@{
    ViewData["Title"] = "Add New Book";
}

<div class="premium-card" style="max-width: 600px; margin: 0 auto;">
    <h3 class="mb-4" style="font-family:var(--font-outfit); font-weight:700;">Add New Book</h3>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-semibold"></label>
            <input asp-for="Title" class="form-control" placeholder="Enter book title" style="border-radius:8px;" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Author" class="form-label fw-semibold"></label>
            <input asp-for="Author" class="form-control" placeholder="Enter author name" style="border-radius:8px;" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ISBN" class="form-label fw-semibold"></label>
            <input asp-for="ISBN" class="form-control" placeholder="Enter ISBN number" style="border-radius:8px;" />
            <span asp-validation-for="ISBN" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Publisher" class="form-label fw-semibold"></label>
            <input asp-for="Publisher" class="form-control" placeholder="Enter publisher" style="border-radius:8px;" />
            <span asp-validation-for="Publisher" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PublishDate" class="form-label fw-semibold"></label>
            <input asp-for="PublishDate" type="date" class="form-control" style="border-radius:8px;" />
            <span asp-validation-for="PublishDate" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="TotalCopies" class="form-label fw-semibold"></label>
            <input asp-for="TotalCopies" class="form-control" type="number" min="1" value="1" style="border-radius:8px;" />
            <span asp-validation-for="TotalCopies" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:8px;">Back to List</a>
            <button type="submit" class="btn-premium">Save Book</button>
        </div>
    </form>
</div>
